{
  "name": "ngi-connect-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "powershell -Command \"Get-NetTCPConnection -LocalPort 3002 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"",
